FROM docker.io/library/ubuntu:22.04

# Installa SSH, sudo, Docker e le dipendenze per Ansible.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        openssh-server \
        sudo \
        docker.io \
        python3 \
        python3-requests \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*
# Crea genericuser e lo abilita a usare sudo senza password.
RUN useradd --create-home --shell /bin/bash genericuser && \
    echo 'genericuser ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/genericuser && \
    chmod 0440 /etc/sudoers.d/genericuser

# Installa la chiave pubblica autorizzata per genericuser.
RUN install -d -m 0700 -o genericuser -g genericuser /home/genericuser/.ssh
COPY id_key_genericuser.pub /home/genericuser/.ssh/authorized_keys
RUN chown genericuser:genericuser /home/genericuser/.ssh/authorized_keys && \
    chmod 0600 /home/genericuser/.ssh/authorized_keys

# Configura SSH: niente root, niente password, accesso solo a genericuser.
RUN mkdir -p /var/run/sshd && \
    sed -ri 's/^[#[:space:]]*PermitRootLogin[[:space:]].*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -ri 's/^[#[:space:]]*PasswordAuthentication[[:space:]].*/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -ri 's/^[#[:space:]]*PubkeyAuthentication[[:space:]].*/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo 'AllowUsers genericuser' >> /etc/ssh/sshd_config

EXPOSE 22

# Installa lo script che avvia SSH e Docker.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh && \
    rm -f /etc/ssh/ssh_host_*

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]